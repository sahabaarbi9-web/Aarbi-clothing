# ============================================================
# AARBI CLOTHING — Backend ke environment variable
# Copy karo: .env.example -> .env  aur apne real values daalo.
# .env file git me kabhi push NAHI hoti (dekh .gitignore).
# ============================================================

# Server port (Railway/Render apna PORT khud deta hai; fallback 3000)
PORT=3000

# Supabase project URL: Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key:  Project Settings > API > Project API keys
# Frontend/read purposes ke liye theek hai.
SUPABASE_ANON_KEY=your-anon-key-here

# Service role (secret) key: backend me CRUD ke liye sabse safe
# (RLS ko bypass karta hai). Yeh key kabhi frontend/galat jagah mat rakhna.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================================
# ADMIN LOGIN (Inventory Dashboard)
# Credentials change karne ke liye yahan dalo
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password